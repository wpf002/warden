      "match": {
        "user": "deploy-bot"
      },
      "label": "true_positive"
    },
    {
      "rule": "iam_admin_grant",
      "match": {
        "user": "deploy-bot"
      },
      "label": "true_positive"
    },
    {
      "rule": "cloud_logging_disabled",
      "match": {
        "user": "deploy-bot"
      },
      "label": "true_positive"
    },
    {
      "rule": "unusual_region",
      "match": {
        "user": "deploy-bot"
      },
      "label": "true_positive"
    }
  ],
  "incidents": [
    {
      "rules": [
        "console_login_no_mfa",
        "iam_admin_grant",
        "cloud_logging_disabled",
