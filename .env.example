# LLM
ANTHROPIC_API_KEY=
WARDEN_LLM=anthropic            # anthropic | mock
WARDEN_MODEL=claude-sonnet-4-5

# Embeddings: default = Chroma ONNX MiniLM (downloads once), hash = offline fallback
WARDEN_EMBEDDINGS=default

# Paths
WARDEN_DATA_DIR=data
WARDEN_LOG_FILE=data/sample_logs/auth.jsonl

# Detection
WARDEN_BF_THRESHOLD=10          # failed logins from one source IP in window
WARDEN_BF_WINDOW_SEC=300

# Guardrails
WARDEN_AUTO_ACTION_MIN_RISK=80  # risk >= this auto-executes allowlisted actions
WARDEN_RULE_THRESHOLDS=password_spray:70   # per-rule override
WARDEN_HUMAN_APPROVAL_ACTIONS=lock_user   # comma list, always need analyst approval
WARDEN_IP_SAFELIST=10.0.0.1,10.0.0.2
